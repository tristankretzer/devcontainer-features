{
  "name": "REUSE",
  "id": "reuse",
  "version": "1.0.1",
  "description": "Installs the REUSE tool for checking license compliance.",
  "documentationURL": "https://github.com/tristankretzer/devcontainer-features/tree/master/src/reuse",
  "licenseURL": "https://github.com/tristankretzer/devcontainer-features/blob/master/LICENSE",
  "options": {
    "version": {
      "type": "string",
      "proposals": [
        "latest"
      ],
      "default": "latest",
      "description": "REUSE tool version, either 'latest' or an exact version from PyPI"
    }
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/python:1"
  ]
}
